# MarketThread Application
APP_NAME=MarketThread
APP_ENV=development
LOG_LEVEL=INFO

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL
POSTGRES_DB=marketthread
POSTGRES_USER=marketthread
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://marketthread:change-me@localhost:5432/marketthread

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

REDIS_URL=redis://localhost:6379/0

# Authentication
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256

# External Providers
MARKET_DATA_API_KEY=
NEWS_API_KEY=
LLM_API_KEY=

# Email / Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TIMEOUT=10
SMTP_USE_TLS=true

# Observability
SENTRY_DSN=

# Market Data
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=
